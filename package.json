{
  "name": "dap-web",
  "private": true,
  "version": "1.0.0",
  "description": "Astro Web IDE, Live Debugger, and Static/Runtime Analyzer for DAP pseudocode powered by https://github.com/rafiathallah3/dap via Go WebAssembly",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "build:wasm": "bash ./scripts/build-wasm.sh",
    "build:wasm:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-wasm.ps1"
  },
  "dependencies": {
    "@astrojs/react": "latest",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "latest",
    "lucide-react": "^0.511.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
